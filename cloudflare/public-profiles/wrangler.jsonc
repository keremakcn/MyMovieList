{
  "name": "myshelf-profiles",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {"pattern": "profiles.myshelf.cloud", "custom_domain": true},
    {"pattern": "myshelf.cloud/u/*", "zone_name": "myshelf.cloud"}
  ],
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "SUPABASE_URL": "https://qiztpurcgtlfvvvjmpma.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_CrggFrsyba-HO49l-2Kvcw_ipOjBG4q"
  },
  "ratelimits": [
    {"name": "PROFILE_LIMITER", "namespace_id": "2001", "simple": {"limit": 60, "period": 60}}
  ]
}
